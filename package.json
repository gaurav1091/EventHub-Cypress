{
  "name": "eventhub-automation-cypress",
  "version": "0.1.0",
  "description": "Enterprise-ready Cypress JavaScript BDD framework for EventHub UI and future API automation.",
  "private": true,
  "scripts": {
    "cy:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "cy:run": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "test": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "test:smoke": "env -u ELECTRON_RUN_AS_NODE cypress run --env tags=@smoke",
    "test:regression": "env -u ELECTRON_RUN_AS_NODE cypress run --env tags=@regression",
    "test:qa:smoke": "env -u ELECTRON_RUN_AS_NODE EVENTHUB_ENV=qa cypress run --env tags=@smoke",
    "test:stage:smoke": "env -u ELECTRON_RUN_AS_NODE EVENTHUB_ENV=stage cypress run --env tags=@smoke",
    "test:prod-smoke": "env -u ELECTRON_RUN_AS_NODE EVENTHUB_ENV=prod-smoke cypress run --env tags='@smoke and not @stateful'",
    "test:auth": "env -u ELECTRON_RUN_AS_NODE cypress run --spec 'cypress/e2e/features/auth/*.feature'",
    "test:events": "env -u ELECTRON_RUN_AS_NODE cypress run --spec 'cypress/e2e/features/events/*.feature'",
    "test:bookings": "env -u ELECTRON_RUN_AS_NODE cypress run --spec 'cypress/e2e/features/bookings/*.feature'",
    "test:admin": "env -u ELECTRON_RUN_AS_NODE cypress run --spec 'cypress/e2e/features/admin/*.feature'",
    "test:api": "env -u ELECTRON_RUN_AS_NODE cypress run --spec 'cypress/e2e/features/api/*.feature'",
    "test:hybrid": "env -u ELECTRON_RUN_AS_NODE cypress run --spec 'cypress/e2e/features/hybrid/*.feature'",
    "test:a11y": "env -u ELECTRON_RUN_AS_NODE cypress run --spec 'cypress/e2e/features/accessibility/*.feature'",
    "test:visual": "env -u ELECTRON_RUN_AS_NODE cypress run --spec 'cypress/e2e/features/visual/*.feature'",
    "cleanup:test-data": "node scripts/cleanup-test-data.js",
    "doctor": "node scripts/doctor.js",
    "wait:app": "node scripts/wait-for-url.js",
    "impact:list": "node scripts/determine-impacted-tests.js",
    "report:html": "node scripts/generate-cucumber-html-report.js",
    "report:history": "node scripts/generate-report-history.js",
    "report:combined": "node scripts/generate-combined-report-summary.js",
    "report:dashboard": "node scripts/generate-combined-html-dashboard.js",
    "report:github-summary": "node scripts/generate-github-step-summary.js",
    "visual:compare": "node scripts/compare-visual-baselines.js",
    "visual:approve": "node scripts/approve-visual-baselines.js",
    "security:audit": "npm audit --audit-level=critical",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "ajv": "^8.20.0",
    "axe-core": "^4.12.1",
    "cypress": "14.5.4",
    "cypress-axe": "^1.7.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-cypress": "^6.4.3",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "diff": "^8.0.2",
    "serialize-javascript": "^7.0.7"
  },
  "cypress-cucumber-preprocessor": {
    "json": {
      "enabled": true,
      "output": "reports/cucumber/cucumber-report.json"
    },
    "filterSpecs": true,
    "omitFiltered": true,
    "messages": {
      "enabled": true,
      "output": "reports/cucumber/messages.ndjson"
    },
    "stepDefinitions": [
      "cypress/e2e/step_definitions/**/*.js"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
